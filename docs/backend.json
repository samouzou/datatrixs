
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents an individual user within the Datatrixs application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "externalAuthIdentifier": {
          "type": "string",
          "description": "Unique identifier provided by the external authentication system."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "firstName": {
          "type": "string",
          "description": "The first name of the user."
        },
        "lastName": {
          "type": "string",
          "description": "The last name of the user."
        },
        "role": {
          "type": "string",
          "description": "The application-specific role assigned to the user."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the user profile was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp indicating when the user profile was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "externalAuthIdentifier",
        "email",
        "firstName",
        "lastName",
        "role",
        "createdAt",
        "updatedAt"
      ]
    },
    "Company": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Company",
      "type": "object",
      "description": "Represents a private equity holding company.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "members": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "admin",
              "member"
            ]
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "createdAt",
        "updatedAt"
      ]
    },
    "CompanyInvitation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CompanyInvitation",
      "type": "object",
      "description": "Represents an invitation sent to a user to join a holding company.",
      "properties": {
        "id": {
          "type": "string"
        },
        "companyId": {
          "type": "string"
        },
        "companyName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "role": {
          "type": "string",
          "enum": [
            "admin",
            "member"
          ]
        },
        "invitedBy": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "accepted",
            "declined"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "companyId",
        "companyName",
        "email",
        "role",
        "status",
        "createdAt"
      ]
    },
    "Location": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Location",
      "type": "object",
      "description": "Represents an individual retail unit managed by a holding company.",
      "properties": {
        "id": {
          "type": "string"
        },
        "companyId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "addressLine1": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "zipCode": {
          "type": "string"
        },
        "phoneNumber": {
          "type": "string"
        },
        "companyMembers": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "admin",
              "member"
            ]
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "companyId",
        "name",
        "addressLine1",
        "city",
        "state",
        "zipCode",
        "phoneNumber",
        "createdAt",
        "updatedAt"
      ]
    },
    "SavedReport": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SavedReport",
      "type": "object",
      "description": "Persistent analysis results or reports saved by users.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["Financial Report", "Data Export", "Analysis"] },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "metadata": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "type", "createdAt"]
    },
    "FinancialRecord": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FinancialRecord",
      "type": "object",
      "description": "A single financial metric record for a specific period and location.",
      "properties": {
        "locationId": { "type": "string" },
        "locationName": { "type": "string" },
        "period": { "type": "string", "description": "e.g., 'Q1 2024'" },
        "metric": { "type": "string", "enum": ["Revenue", "Net Profit", "COGS", "Operating Expenses", "Inventory Value"] },
        "value": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["locationId", "locationName", "period", "metric", "value", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "google.com"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores individual user profiles."
        }
      },
      {
        "path": "/companies/{companyId}",
        "definition": {
          "entityName": "Company",
          "schema": {
            "$ref": "#/backend/entities/Company"
          },
          "description": "Stores holding company information."
        }
      },
      {
        "path": "/company_invitations/{invitationId}",
        "definition": {
          "entityName": "CompanyInvitation",
          "schema": {
            "$ref": "#/backend/entities/CompanyInvitation"
          },
          "description": "Stores invitations sent to join companies."
        }
      },
      {
        "path": "/locations/{locationId}",
        "definition": {
          "entityName": "Location",
          "schema": {
            "$ref": "#/backend/entities/Location"
          },
          "description": "Stores individual retail location information."
        }
      },
      {
        "path": "/saved_reports/{reportId}",
        "definition": {
          "entityName": "SavedReport",
          "schema": {
            "$ref": "#/backend/entities/SavedReport"
          },
          "description": "Stores saved analyst insights and reports."
        }
      },
      {
        "path": "/locations/{locationId}/financial_records/{recordId}",
        "definition": {
          "entityName": "FinancialRecord",
          "schema": {
            "$ref": "#/backend/entities/FinancialRecord"
          },
          "description": "Stores time-series financial data for a specific location."
        }
      }
    ]
  }
}
