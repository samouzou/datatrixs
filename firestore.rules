
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMember(memberMap) {
      return isSignedIn() && memberMap[request.auth.uid] == true;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/app_roles_admin/$(request.auth.uid));
    }

    function isEmailInvited(email) {
      return isSignedIn() && request.auth.token.email == email;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    match /companies/{companyId} {
      allow list: if isSignedIn() && (resource == null || isMember(resource.data.members)) || isAdmin();
      allow get: if isMember(resource.data.members) || isAdmin();
      allow create: if isSignedIn();
      allow update: if isMember(resource.data.members) || isAdmin();
      allow delete: if isAdmin();
    }

    match /company_invitations/{invitationId} {
      // Allow user to see invites sent to their email
      allow list: if isSignedIn() && (resource == null || resource.data.email == request.auth.token.email);
      allow get: if isSignedIn() && resource.data.email == request.auth.token.email;
      
      // Allow company members to create and manage invites for their company
      allow create: if isSignedIn() && isMember(get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.members);
      allow update, delete: if isSignedIn() && (
        resource.data.email == request.auth.token.email || 
        isMember(get(/databases/$(database)/documents/companies/$(resource.data.companyId)).data.members)
      );
    }

    match /locations/{locationId} {
      allow list: if isSignedIn() && (resource == null || isMember(resource.data.companyMembers)) || isAdmin();
      allow get: if isMember(resource.data.companyMembers) || isAdmin();
      allow create: if isMember(request.resource.data.companyMembers) || isAdmin();
      allow update: if isMember(resource.data.companyMembers) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
