
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // High-performance map-based membership check
    function isCompanyMember(membersMap) {
      return isSignedIn() && membersMap != null && (
        membersMap[request.auth.uid] == 'admin' || 
        membersMap[request.auth.uid] == 'member' || 
        membersMap[request.auth.uid] == true
      );
    }

    function isCompanyAdmin(membersMap) {
      return isSignedIn() && membersMap != null && (
        membersMap[request.auth.uid] == 'admin' || 
        membersMap[request.auth.uid] == true
      );
    }
    
    // Check if the current user is an application-level Admin
    // Added exists() check to prevent rule evaluation errors when a user profile is still being created
    function isAppAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // Helper to check if a user is joining by only adding themselves to a membership map
    function isJoining(oldData, newData, mapField) {
      let oldMap = oldData[mapField];
      let newMap = newData[mapField];
      return isSignedIn() && 
             newData.diff(oldData).affectedKeys().hasOnly([mapField, 'updatedAt']) &&
             (oldMap == null || newMap.diff(oldMap).affectedKeys().hasOnly([request.auth.uid]));
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAppAdmin();
      allow list: if isAppAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAppAdmin();
      allow delete: if isAppAdmin();
    }

    match /companies/{companyId} {
      allow list: if isSignedIn() && (isCompanyMember(resource.data.members) || isAppAdmin());
      allow get: if isSignedIn() && (isCompanyMember(resource.data.members) || isAppAdmin());
      allow create: if isSignedIn();
      allow update: if isCompanyAdmin(resource.data.members) || isAppAdmin() || isJoining(resource.data, request.resource.data, 'members');
      allow delete: if isAppAdmin();
    }

    match /company_invitations/{invitationId} {
      allow list: if isSignedIn() && (resource.data.email == request.auth.token.email.lower() || isAppAdmin());
      allow get: if isSignedIn() && (resource.data.email == request.auth.token.email.lower() || isAppAdmin());
      allow create: if isSignedIn(); 
      allow update: if isSignedIn() && (
        resource.data.email == request.auth.token.email.lower() || 
        isAppAdmin() ||
        isCompanyAdmin(get(/databases/$(database)/documents/companies/$(resource.data.companyId)).data.members)
      );
      allow delete: if isSignedIn() && isAppAdmin();
    }

    match /locations/{locationId} {
      allow list: if isSignedIn() && (isCompanyMember(resource.data.companyMembers) || isAppAdmin());
      allow get: if isSignedIn() && (isCompanyMember(resource.data.companyMembers) || isAppAdmin());
      allow create: if isSignedIn();
      allow update: if isCompanyAdmin(resource.data.companyMembers) || isAppAdmin() || isJoining(resource.data, request.resource.data, 'companyMembers');
      allow delete: if isAppAdmin();
    }

    match /financial_records/{recordId} {
      allow list: if isSignedIn() && (isCompanyMember(resource.data.companyMembers) || isAppAdmin());
      allow get: if isSignedIn() && (isCompanyMember(resource.data.companyMembers) || isAppAdmin());
      allow create: if isSignedIn() && (isCompanyMember(request.resource.data.companyMembers) || isAppAdmin());
      allow update: if isSignedIn() && (isCompanyAdmin(resource.data.companyMembers) || isAppAdmin());
      allow delete: if isAppAdmin();
    }

    match /saved_reports/{reportId} {
      // Prioritizing the query-compatible check to ensure list queries work correctly even when isAppAdmin is pending
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAppAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAppAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAppAdmin();
      allow delete: if isOwner(resource.data.userId) || isAppAdmin();
    }
  }
}
