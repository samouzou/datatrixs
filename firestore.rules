rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMember(memberMap) {
      return isSignedIn() && memberMap[request.auth.uid] == true;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/app_roles_admin/$(request.auth.uid));
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isAdmin();

      match /report_configurations/{reportId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /app_roles_admin/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /companies/{companyId} {
      // Allow list if the user is a member of the company. 
      // This supports the 'Queryable Access Pattern' where we query by membership.
      allow list: if isSignedIn() && (resource == null || isMember(resource.data.members)) || isAdmin();
      allow get: if isMember(resource.data.members) || isAdmin();
      allow create: if isSignedIn();
      allow update: if isMember(resource.data.members) || isAdmin();
      allow delete: if isAdmin();

      match /charts_of_accounts/{coaId} {
        allow read, write: if isMember(get(/databases/$(database)/documents/companies/$(companyId)).data.members) || isAdmin();
        
        match /accounts/{accountId} {
          allow read, write: if isMember(get(/databases/$(database)/documents/companies/$(companyId)).data.members) || isAdmin();
        }
      }
    }

    match /locations/{locationId} {
      allow list: if isSignedIn() && (resource == null || isMember(resource.data.companyMembers)) || isAdmin();
      allow get: if isMember(resource.data.companyMembers) || isAdmin();
      allow create: if isMember(request.resource.data.companyMembers) || isAdmin();
      allow update: if isMember(resource.data.companyMembers) || isAdmin();
      allow delete: if isAdmin();
    }

    match /financial_data_sources/{sourceId} {
      allow get, list: if isMember(resource.data.companyMembers) || isAdmin();
      allow create, update, delete: if isMember(resource.data.companyMembers) || isAdmin();
    }

    match /financial_transactions/{txId} {
      allow get, list: if isMember(resource.data.companyMembers) || isAdmin();
      allow create, update, delete: if isMember(resource.data.companyMembers) || isAdmin();

      match /financial_entries/{entryId} {
        allow read, write: if isMember(get(/databases/$(database)/documents/financial_transactions/$(txId)).data.companyMembers) || isAdmin();
      }
    }

    match /standard_charts_of_accounts/{coaId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /accounts/{accountId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }
  }
}