
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // High-performance map-based membership check
    function isCompanyMember(membersMap) {
      return isSignedIn() && membersMap != null && (
        membersMap[request.auth.uid] == 'admin' || 
        membersMap[request.auth.uid] == 'member' || 
        membersMap[request.auth.uid] == true
      );
    }

    function isCompanyAdmin(membersMap) {
      return isSignedIn() && membersMap != null && (
        membersMap[request.auth.uid] == 'admin' || 
        membersMap[request.auth.uid] == true
      );
    }
    
    // Fallback check: pull parent company data to bridge denormalization lag
    function isMemberOfParentCompany(companyId) {
       return isCompanyMember(get(/databases/$(database)/documents/companies/$(companyId)).data.members);
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/app_roles_admin/$(request.auth.uid));
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    match /companies/{companyId} {
      allow list: if isSignedIn() && (isCompanyMember(resource.data.members) || isAdmin());
      allow get: if isSignedIn() && (isCompanyMember(resource.data.members) || isAdmin());
      allow create: if isSignedIn();
      // Allow self-join if the user is updating only their own membership status
      allow update: if isCompanyAdmin(resource.data.members) || isAdmin() || 
        (isSignedIn() && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt']) &&
         request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]));
      allow delete: if isAdmin();
    }

    match /company_invitations/{invitationId} {
      // Ensure case-insensitive email matching for invitations
      allow list: if isSignedIn() && (resource.data.email == request.auth.token.email.lower() || isAdmin());
      allow get: if isSignedIn() && (resource.data.email == request.auth.token.email.lower() || isAdmin());
      allow create: if isSignedIn(); 
      allow update: if isSignedIn() && (
        resource.data.email == request.auth.token.email.lower() || 
        isAdmin()
      );
      allow delete: if isSignedIn() && isAdmin();
    }

    match /locations/{locationId} {
      // QAP: Prioritize the local map check, fallback to parent company check
      allow list: if isSignedIn() && (isCompanyMember(resource.data.companyMembers) || isMemberOfParentCompany(resource.data.companyId) || isAdmin());
      allow get: if isSignedIn() && (isCompanyMember(resource.data.companyMembers) || isMemberOfParentCompany(resource.data.companyId) || isAdmin());
      allow create: if isSignedIn();
      allow update: if isCompanyAdmin(resource.data.companyMembers) || isAdmin() ||
        (isSignedIn() && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyMembers', 'updatedAt']) &&
         request.resource.data.companyMembers.diff(resource.data.companyMembers).affectedKeys().hasOnly([request.auth.uid]));
      allow delete: if isAdmin();
    }
  }
}
